{
    admin off
    servers {
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }
    log default {
        output stdout
        format json {
            time_key time
            time_format rfc3339_nano
            level_key level
            level_format lower
            message_key msg
            name_key logger
        }
    }
}

:8080 {
    root * /opt/cattr/app/public
    encode zstd gzip
    header {
        -Server
        -Via
        -X-Powered-By
        X-Frame-Options SAMEORIGIN
        X-Content-Type-Options nosniff
    }
    header /sw.js Cache-Control "no-cache"

    log {
        output stdout
        format filter {
            request>headers>Sec-Websocket-Key delete
            resp_headers>Sec-Websocket-Accept delete

            wrap json {
                time_key time
                time_format rfc3339_nano
                level_key level
                level_format lower
                message_key msg
                name_key logger
            }
        }
    }
    request_body {
        max_size 512MiB
    }

    @websocket {
        path /app/*

        header_regexp Connection (?i).*Upgrade.*
        header_regexp Upgrade (?i)^websocket$
    }
    @php path *.php
    @static {
        expression `file('\{path}') && {file_match.type} == "file"`
        not path *.php
    }

    route {
        reverse_proxy @websocket 127.0.0.1:8081

        reverse_proxy @php 127.0.0.1:8090 {
            transport http {
                read_timeout 300s
                write_timeout 300s
            }
            header_up SERVER_PORT 8080
            header_up REMOTE_ADDR {client_ip}
        }

        file_server @static {
            precompressed br gzip
        }

        reverse_proxy 127.0.0.1:8090 {
            transport http {
                read_timeout 300s
                write_timeout 300s
            }
            header_up SERVER_PORT 8080
            header_up REMOTE_ADDR {client_ip}
        }
    }
}
