{
  "name": "cattr/backend-application",
  "description": "Backend Application for Cattr",
  "license": "SSPL-1.0",
  "type": "project",
  "homepage": "https://cattr.app",
  "support": {
    "email": "hi@cattr.app",
    "docs": "https://docs.cattr.app/backend#/",
    "forum": "https://github.com/orgs/cattr-app/discussions",
    "issues": "https://github.com/cattr-app/server-application/issues",
    "chat": "https://cattr.app",
    "source": "https://github.com/cattr-app/server-application"
  },
  "require": {
    "php": "^8.3",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-zip": "*",
    "elhebert/laravel-sri": "^3.5",
    "erusev/parsedown": "^1.7",
    "fakerphp/faker": "^1.21",
    "flugger/laravel-responder": "^3.3.0",
    "intervention/image": "^2.7",
    "kalnoy/nestedset": "^7.0",
    "laravel/framework": "^13.0",
    "laravel/octane": "^2.2",
    "laravel/reverb": "^1.0",
    "laravel/sanctum": "^4.0",
    "maatwebsite/excel": "^3.1",
    "matanyadaev/laravel-eloquent-spatial": "^4.8",
    "mpdf/mpdf": "^8.0",
    "nesbot/carbon": "^3.0",
    "nwidart/laravel-modules": "^13.0",
    "phpoffice/phpspreadsheet": "^1.30",
    "phpseclib/phpseclib": "^4.0",
    "promphp/prometheus_client_php": "^2.15",
    "rybakit/msgpack": "^0.10.0",
    "spatie/temporary-directory": "^2.2",
    "staudenmeir/laravel-adjacency-list": "^1.24"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.7",
    "itsgoingd/clockwork": "^5.1",
    "laravel/tinker": "^3.0",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^12.0",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeds/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "dumphelpers": [
      "@php artisan ide-helper:generate",
      "@php artisan ide-helper:meta"
    ],
    "pre-install-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "dumperd": [
      "@php artisan generate:erd erd.svg --format=svg"
    ],
    "kg": [
      "@php artisan key:generate --ansi"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "gitlab-domains": ["git.amazingcat.net"],
    "allow-plugins": {
      "php-http/discovery": true,
      "wikimedia/composer-merge-plugin": false
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
