APP_KEY=
# When true, request_content in error logs is NOT encrypted
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080

REQUEST_SIGNATURE=_CHANGE_ME_

DB_USERNAME=root
DB_PASSWORD=password

MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -i -t"

FRONTEND_APP_URL=

# External modules are disabled unless explicitly set to the string "true".
# Internal Cattr frontend modules are always enabled.
# MODULE_FRONTEND_AMAZING_CAT_REDMINE_INTEGRATION_ENABLED=true
# MODULE_BACKEND_CATTR_REDMINE_INTEGRATION_ENABLED=true
# MODULE_FRONTEND_AMAZING_CAT_GITLAB_INTEGRATION_ENABLED=true
# MODULE_BACKEND_CATTR_GITLAB_INTEGRATION_ENABLED=true
# MODULE_FRONTEND_AMAZING_CAT_DEMO_MODULE_ENABLED=true
# MODULE_BACKEND_CATTR_DEMO_ENABLED=true

# ReCaptcha Settings
## Is it enabled?
RECAPTCHA_ENABLED=false

## Site & secret keys
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_GOOGLE_URL=https://www.google.com/recaptcha/api/siteverify

## If captcha triggered, for how long Core will request it from this client (in seconds)
RECAPTCHA_TTL=3600

## How many times client should fail the login to trigger recaptcha
RECAPTCHA_FAILED_ATTEMPTS=10

## How many times client should fail the login with captcha to be banned
RECAPTCHA_BAN_ATTEMPTS=10

## Is ban (rate limiter) enabled?
RATE_LIMITER_ENABLED=false

## Ban time (in seconds)
RATE_LIMITER_TTL=3600

CLOCKWORK_ENABLE=false

VUE_APP_STORAGE_SPACE_MAX_USED=75

# Websocket settings
REVERB_APP_KEY=cattr
REVERB_APP_SECRET=secret

## For local development
# REVERB_HOST=127.0.0.1
# REVERB_SCHEME=http
# REVERB_PORT=8080
# The browser connects to the host, scheme and port of the page. Override at build time only if Reverb
# is published elsewhere: MIX_REVERB_HOST, MIX_REVERB_PATH, MIX_REVERB_FRONTEND_PORT.
# MIX_REVERB_FRONTEND_PORT=8080

# Global SCREENSHOTS_STATE
## To not lock the value for admin in Company Settings, use any
## Never require screenshots (admin CANNOT change at Company Settings), use forbidden
## Always require screenshots (admin CANNOT change at Company Settings), use required
## Optional for every user, use optional
SCREENSHOTS_STATE=any

# Offline screenshot archives are validated within the upload request and attached by a queue job (a queue worker
# is required). They are rejected before that above these limits: number of screenshots and total uncompressed
# size in bytes. 1000 screenshots take the job up to ~5 min (~310 ms per screenshot on S3, ~75 ms on the local disk).
# OFFLINE_SCREENSHOTS_MAX_FILES=1000
# OFFLINE_SCREENSHOTS_MAX_SIZE_BYTES=1073741824
# Seconds one attempt of the job may run (keep it below QUEUE_RETRY_AFTER) and the number of attempts; a retried
# job continues after the screenshots it has already processed.
# OFFLINE_SCREENSHOTS_JOB_TIMEOUT=900
# OFFLINE_SCREENSHOTS_JOB_TRIES=3

# Octane (Swoole) worker counts; unset = Swoole default (one per host CPU)
# OCTANE_WORKERS=
# OCTANE_TASK_WORKERS=

# Queue: seconds before a reserved job is handed to another worker. Must be greater than the
# longest job timeout (attachment hash verification: 900 s), otherwise a running job is started twice.
# QUEUE_RETRY_AFTER=960
# Unique jobs (e.g. attachment hash verification) take their lock in the dispatcher and release it in
# the worker: when web, queue and scheduler run in separate containers they must share a lock-capable
# cache store (e.g. CACHE_DRIVER=redis), not the per-container file cache.
# The screenshot cleanup status shown on the About page is shared through the same cache store.
# Seconds a requested cleanup may run in the queue worker (below QUEUE_RETRY_AFTER), may wait for a worker,
# and may run without progress before it is reported as failed. The last one is raised to at least
# CLEANER_JOB_TIMEOUT + 60.
# CLEANER_JOB_TIMEOUT=900
# CLEANER_QUEUED_TIMEOUT=3600
# CLEANER_RUNNING_TIMEOUT=960
# Seconds a requested cleanup waits for the run lock of another one before it is reported as failed
# CLEANER_LOCK_WAIT=60
# A cleanup stops after CLEANER_JOB_TIMEOUT - CLEANER_LOCK_WAIT - 60 seconds, the next one removes the rest
