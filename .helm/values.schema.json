{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cattr-server values",
  "definitions": {
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "httpProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "execProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "additionalProperties": false
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ]
      }
    },
    "workers": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[0-9]*$"
    },
    "accessModes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ReadWriteOnce",
          "ReadWriteOncePod",
          "ReadWriteMany",
          "ReadOnlyMany"
        ]
      },
      "minItems": 1
    }
  },
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "properties": {
        "storageClass": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        }
      }
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "cattr": {
      "type": "object",
      "properties": {
        "appUrl": {
          "type": "string",
          "description": "Public URL, e.g. https://cattr.example.com (required)"
        },
        "appKey": {
          "type": "string",
          "description": "Laravel APP_KEY (raw base64 or base64:...), 32 bytes. Never auto-generated."
        },
        "reverbAppSecret": {
          "type": "string",
          "description": "Reverb application secret. Never auto-generated."
        },
        "existingSecret": {
          "type": "string",
          "description": "Secret with APP_KEY / REVERB_APP_SECRET"
        },
        "existingSecretKeys": {
          "type": "object",
          "properties": {
            "appKey": {
              "type": "string",
              "minLength": 1
            },
            "reverbAppSecret": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "appEnv": {
          "type": "string"
        },
        "appDebug": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "logChannel": {
          "type": "string",
          "description": "Laravel log channel from config/logging.php (the sentry channel was removed)",
          "enum": [
            "stack",
            "single",
            "daily",
            "monthly",
            "slack",
            "papertrail",
            "stderr",
            "syslog",
            "errorlog",
            "null",
            "emergency"
          ]
        },
        "restartPolicy": {
          "type": "string",
          "description": "CATTR_RESTART_POLICY",
          "enum": [
            "shutdown",
            "restart"
          ]
        },
        "extraEnv": {
          "$ref": "#/definitions/env"
        },
        "extraEnvFrom": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "pvc (single node) or s3 (separate Deployments)",
          "enum": [
            "pvc",
            "s3"
          ]
        },
        "pvc": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "$ref": "#/definitions/accessModes"
            },
            "size": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "s3": {
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "usePathStyleEndpoint": {
              "type": "boolean"
            },
            "accessKeyId": {
              "type": "string"
            },
            "secretAccessKey": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKeys": {
              "type": "object",
              "properties": {
                "accessKeyId": {
                  "type": "string",
                  "minLength": 1
                },
                "secretAccessKey": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "sizeLimit": {
              "type": "string"
            },
            "medium": {
              "type": "string",
              "enum": [
                "",
                "Memory"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretPasswordKey": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "integer",
          "minimum": 0
        },
        "cacheDatabase": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "rootPassword": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKeys": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string",
              "minLength": 1
            },
            "rootPassword": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mysql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Built-in single-node demo MySQL"
        },
        "acknowledgeRemoval": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "$ref": "#/definitions/accessModes"
            },
            "size": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "startupProbe": {
          "$ref": "#/definitions/httpProbe"
        },
        "livenessProbe": {
          "$ref": "#/definitions/httpProbe"
        },
        "readinessProbe": {
          "$ref": "#/definitions/httpProbe"
        }
      },
      "additionalProperties": false
    },
    "setup": {
      "type": "object",
      "properties": {
        "hook": {
          "type": "boolean"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "extraEnv": {
          "$ref": "#/definitions/env"
        },
        "admin": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "email": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "unsupportedMultiReplica": {
          "type": "boolean"
        },
        "octaneWorkers": {
          "$ref": "#/definitions/workers"
        },
        "octaneTaskWorkers": {
          "$ref": "#/definitions/workers"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "startupProbe": {
          "$ref": "#/definitions/httpProbe"
        },
        "readinessProbe": {
          "$ref": "#/definitions/httpProbe"
        },
        "livenessProbe": {
          "$ref": "#/definitions/httpProbe"
        },
        "extraEnv": {
          "$ref": "#/definitions/env"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        }
      },
      "additionalProperties": false
    },
    "queue": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "livenessProbe": {
          "$ref": "#/definitions/execProbe"
        },
        "extraEnv": {
          "$ref": "#/definitions/env"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        }
      },
      "additionalProperties": false
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "livenessProbe": {
          "$ref": "#/definitions/execProbe"
        },
        "extraEnv": {
          "$ref": "#/definitions/env"
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "initResources": {
      "$ref": "#/definitions/resources"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "host"
            ]
          }
        },
        "tls": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "pattern": "^([0-9]+(h|m|s|ms))*$"
            },
            "websocket": {
              "type": "string",
              "pattern": "^([0-9]+(h|m|s|ms))*$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpFrom": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
